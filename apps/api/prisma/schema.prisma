generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id          String   @id @default(cuid())
  name        String
  shortName   String?
  countryCode String   @default("CI")
  currency    String   @default("XOF")
  timezone    String   @default("Africa/Abidjan")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  roles       Role[]
  students    Student[]
  parents     Parent[]
  classes     SchoolClass[]
  feeItems    FeeItem[]
  payments    Payment[]
  invoices    Invoice[]
  admissions  Admission[]
  auditLogs   AuditLog[]
}

model User {
  id           String    @id @default(cuid())
  schoolId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school    School     @relation(fields: [schoolId], references: [id])
  roles     UserRole[]
  auditLogs AuditLog[]
  sessions  Session[]

  @@unique([schoolId, email])
}

model Role {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School          @relation(fields: [schoolId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([schoolId, name])
}

model Permission {
  id          String          @id @default(cuid())
  key         String          @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  schoolId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String?
  tokenVersion Int      @default(0)
  ipAddress    String?
  userAgent    String?
  revoked      Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolClass {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  level     String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  students Student[]
}

model Parent {
  id          String   @id @default(cuid())
  schoolId    String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  address     String?
  profession  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  students ParentStudent[]
}

model Student {
  id             String   @id @default(cuid())
  schoolId       String
  classId        String?
  firstName      String
  lastName       String
  matricule      String
  gender         String?
  dateOfBirth    DateTime?
  placeOfBirth   String?
  photoUrl       String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School           @relation(fields: [schoolId], references: [id])
  class        SchoolClass?     @relation(fields: [classId], references: [id])
  parents      ParentStudent[]
  admissions   Admission[]
  payments     Payment[]
  invoices     Invoice[]

  @@unique([schoolId, matricule])
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  relation  String   @default("parent")
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Admission {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  status         String   @default("pending")
  source         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FeeItem {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  amount      Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  effectiveAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, code])
}

model Invoice {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  reference    String   @unique
  total        Decimal  @db.Decimal(10, 2)
  status       String   @default("open")
  issuedAt     DateTime @default(now())
  dueDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  invoiceId    String?
  reference    String   @unique
  amount       Decimal  @db.Decimal(10, 2)
  method       String
  status       String   @default("confirmed")
  paidAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  userId    String?
  action    String
  resource  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}
